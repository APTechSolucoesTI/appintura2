# Variáveis do frontend (Vite).
#
# São resolvidas em tempo de BUILD e ficam embutidas no bundle — definir no
# runtime do container não tem efeito. No Dokploy elas vão em "Build Args",
# não em variáveis de ambiente do serviço.
#
# Copie para `.env.local` para rodar em desenvolvimento (`.env*` está no
# .gitignore).

VITE_SUPABASE_URL=https://supabase.aptechinfo.com.br:75

# A anon key é pública por natureza: vai no navegador de todo usuário. Quem
# protege os dados é o RLS, não o sigilo dela.
#
# A SERVICE_ROLE nunca entra aqui — ela ignora RLS por completo e daria a
# qualquer visitante acesso a todas as empresas.
VITE_SUPABASE_ANON_KEY=
