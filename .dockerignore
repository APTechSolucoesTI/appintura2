# Fora do contexto de build: acelera o envio ao daemon e, mais importante,
# impede que qualquer um destes acabe dentro da imagem.

node_modules
dist
dist-ssr

.git
.gitignore

# Credenciais e configuração local — nada disto deve entrar na imagem. As
# variáveis do Vite chegam por ARG no Dockerfile.
.env
.env.*
*.local

# Migrations e seed rodam no Supabase, não no container do front.
#
# `supabase/functions` NÃO entra aqui: `src/services/pdf-service.ts` importa
# `functions/_shared/romaneio-pdf`, o layout do PDF que o front e a Edge
# Function compartilham para gerar o MESMO documento. Excluir a pasta inteira
# quebra o `tsc -b` dentro da imagem.
supabase/migrations
supabase/seed.sql
supabase/.temp
supabase/config.toml

.vscode
.idea
.claude
*.log
.DS_Store
